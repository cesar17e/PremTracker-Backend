# Keep the build context limited to the files the Dockerfile needs.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!knexfile.ts
!src/
!src/**
!migrations/
!migrations/**

# Never send local dependencies, secrets, or credentials to the build.
**/node_modules
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
